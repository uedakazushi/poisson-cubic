{
  "latex-workshop.latex.recipe.default": "latexmk (repository root)",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (repository root)",
      "tools": [
        "latexmk-root"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-root",
      "command": "bash",
      "args": [
        "-c",
        "cd \"$1\" && shift && exec latexmk -r .latexmkrc \"$@\"",
        "latexmk-root",
        "%WORKSPACE_FOLDER%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
  "latex-workshop.latex.autoBuild.run": "onSave"
}
